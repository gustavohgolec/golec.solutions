// Prisma schema para o Golec Hub
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Usuários e Autenticação (RBAC)
// -------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  role          String    @default("COMMERCIAL") // OWNER, ADMIN, COMMERCIAL, PROJECT_MANAGER, COLLABORATOR, FINANCIAL, PARTNER
  avatarUrl     String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedLeads         Lead[]          @relation("AssignedLeads")
  assignedOpportunities Opportunity[]   @relation("AssignedOpportunities")
  managedProjects       Project[]       @relation("ManagedProjects")
  assignedTasks         Task[]          @relation("AssignedTasks")
  collaboratorTasks     Task[]          @relation("CollaboratorTasks")
  activities            Activity[]
  taskComments          TaskComment[]
  createdProgress       KnowledgeProgress[]
  auditLogs             AuditLog[]
}

// -------------------------------------------------------------
// CRM: Leads, Empresas, Contatos e Oportunidades
// -------------------------------------------------------------

model Company {
  id          String   @id @default(cuid())
  name        String
  tradeName   String?
  document    String?  // CNPJ / CPF
  segment     String?
  city        String?
  state       String?
  website     String?
  instagram   String?
  notes       String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  clients       Client[]
}

model Contact {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  role        String?
  email       String?
  phone       String?
  whatsapp    String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads         Lead[]
  opportunities Opportunity[]
}

model Lead {
  id          String   @id @default(cuid())
  title       String
  companyId   String?
  contactId   String?
  source      String   @default("OUTRO") // INDICACAO, INSTAGRAM, SITE, WHATSAPP, PROSPECCAO, EVENTO, OUTRO
  status      String   @default("NOVO")  // NOVO, QUALIFICADO, DESQUALIFICADO, CONVERTIDO
  assignedToId String?
  valueEst    Float?
  segment     String?
  notes       String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company?  @relation(fields: [companyId], references: [id])
  contact    Contact?  @relation(fields: [contactId], references: [id])
  assignedTo User?     @relation("AssignedLeads", fields: [assignedToId], references: [id])
}

model Opportunity {
  id           String    @id @default(cuid())
  title        String
  companyId    String
  contactId    String?
  assignedToId String?
  stageId      String
  value        Float     @default(0.0)
  probability  Int       @default(50)
  expectedClose DateTime?
  lostReason   String?
  isWon        Boolean   @default(false)
  isLost       Boolean   @default(false)
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company       @relation(fields: [companyId], references: [id])
  contact    Contact?      @relation(fields: [contactId], references: [id])
  assignedTo User?         @relation("AssignedOpportunities", fields: [assignedToId], references: [id])
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  activities Activity[]
  proposals  Proposal[]
  clients    Client[]
}

model PipelineStage {
  id        String   @id @default(cuid())
  name      String
  order     Int
  color     String?
  createdAt DateTime @default(now())

  opportunities Opportunity[]
}

model Activity {
  id            String    @id @default(cuid())
  opportunityId String?
  userId        String
  type          String    // CALL, MEETING, WHATSAPP, EMAIL, NOTE, TASK
  title         String
  description   String?
  dueDate       DateTime?
  completed     Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
}

model Proposal {
  id            String   @id @default(cuid())
  opportunityId String
  code          String   @unique
  title         String
  totalValue    Float
  status        String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  validUntil    DateTime?
  content       String?
  fileUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// Clientes, Contratos e Onboarding
// -------------------------------------------------------------

model Client {
  id            String   @id @default(cuid())
  companyId     String
  opportunityId String?
  status        String   @default("ONBOARDING") // ONBOARDING, ACTIVE, PAUSED, FINISHED
  startDate     DateTime @default(now())
  renewalDate   DateTime?
  internalLead  String?  // Nome ou ID do gestor da conta
  driveFolderUrl String?
  passwordsSafeRef String? // Link seguro (sem senhas em texto puro)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  contracts   Contract[]
  projects    Project[]
  transactions FinancialTransaction[]
}

model Contract {
  id         String    @id @default(cuid())
  clientId   String
  code       String    @unique
  title      String
  monthlyFee Float     @default(0.0)
  totalValue Float?
  billingType String   @default("MONTHLY") // RECURRING, ONE_OFF, HOURLY
  startDate  DateTime
  endDate    DateTime?
  signed     Boolean   @default(false)
  fileUrl    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projects Project[]
}

// -------------------------------------------------------------
// Catálogo de Serviços das 4 Unidades Golec
// -------------------------------------------------------------

model ServiceUnit {
  id          String   @id @default(cuid())
  code        String   @unique // MARKETING, CREATIVE, DIGITAL, SYSTEMS
  name        String
  description String?
  color       String?
  createdAt   DateTime @default(now())

  services Service[]
}

model Service {
  id          String   @id @default(cuid())
  unitId      String
  name        String
  description String?
  scope       String?
  deliverables String?
  refPrice    Float    @default(0.0)
  billingModel String  @default("MONTHLY") // MONTHLY, ONE_OFF, HOURLY, CUSTOM
  estimatedCost Float?
  targetMargin  Float?
  defaultDays   Int?
  revisionLimit Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit     ServiceUnit @relation(fields: [unitId], references: [id])
  projects Project[]
}

// -------------------------------------------------------------
// Projetos, Tarefas, Entregáveis e Aprovações
// -------------------------------------------------------------

model Project {
  id           String    @id @default(cuid())
  clientId     String
  contractId   String?
  serviceId    String?
  managerId    String?
  name         String
  description  String?
  status       String    @default("PLANEJAMENTO") // PLANEJAMENTO, EM_ANDAMENTO, EM_REVISAO, PAUSADO, CONCLUIDO
  startDate    DateTime?
  dueDate      DateTime?
  budget       Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id])
  service  Service?  @relation(fields: [serviceId], references: [id])
  manager  User?     @relation("ManagedProjects", fields: [managerId], references: [id])
  tasks    Task[]
  deliverables Deliverable[]
  transactions FinancialTransaction[]
}

model Task {
  id              String    @id @default(cuid())
  projectId       String
  title           String
  description     String?
  status          String    @default("TODO") // BACKLOG, TODO, IN_PROGRESS, INTERNAL_REVIEW, WAITING_CLIENT, ADJUSTS, DONE, BLOCKED
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignedToId    String?
  collaboratorId  String?
  dueDate         DateTime?
  effortHours     Float?
  isRecurring     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo   User?         @relation("AssignedTasks", fields: [assignedToId], references: [id])
  collaborator User?         @relation("CollaboratorTasks", fields: [collaboratorId], references: [id])
  comments     TaskComment[]
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Deliverable {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  fileUrl     String?
  status      String   @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED
  clientFeedback String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// Financeiro (Receitas, Despesas e Fluxo de Caixa)
// -------------------------------------------------------------

model FinancialCategory {
  id        String   @id @default(cuid())
  name      String
  type      String   // INCOME, EXPENSE
  costCenter String?
  createdAt DateTime @default(now())

  transactions FinancialTransaction[]
}

model FinancialTransaction {
  id          String    @id @default(cuid())
  description String
  amount      Float
  type        String    // INCOME, EXPENSE
  status      String    @default("PENDING") // PLANNED, PENDING, PAID, OVERDUE, CANCELLED
  dueDate     DateTime
  paidDate    DateTime?
  categoryId  String?
  clientId    String?
  projectId   String?
  receiptUrl  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category FinancialCategory? @relation(fields: [categoryId], references: [id])
  client   Client?            @relation(fields: [clientId], references: [id])
  project  Project?           @relation(fields: [projectId], references: [id])
}

// -------------------------------------------------------------
// Academia Golec (Módulos, Trilhas do Plano Mestre e Checklists)
// -------------------------------------------------------------

model KnowledgeTrack {
  id          String   @id @default(cuid())
  title       String
  order       Int
  description String?
  badgeColor  String?
  createdAt   DateTime @default(now())

  modules KnowledgeModule[]
}

model KnowledgeModule {
  id          String   @id @default(cuid())
  trackId     String
  order       Int
  title       String
  summary     String?
  contentMd   String?  // Conteúdo detalhado, explicações e orientações
  pdfChapterRef String? // Referência ao capítulo do Plano Mestre PDF
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  track KnowledgeTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  items KnowledgeItem[]
}

model KnowledgeItem {
  id          String   @id @default(cuid())
  moduleId    String
  order       Int
  title       String
  description String?
  isChecklist Boolean  @default(true)
  createdAt   DateTime @default(now())

  module   KnowledgeModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress KnowledgeProgress[]
}

model KnowledgeProgress {
  id          String   @id @default(cuid())
  itemId      String
  status      String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, WAITING_THIRD_PARTY, COMPLETED
  assignedTo  String?
  deadline    DateTime?
  completedAt DateTime?
  updatedById String?
  notes       String?
  updatedAt   DateTime @updatedAt

  item      KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  updatedBy User?         @relation(fields: [updatedById], references: [id])

  @@unique([itemId])
}

// -------------------------------------------------------------
// Auditoria
// -------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
